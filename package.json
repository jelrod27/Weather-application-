{
  "name": "16-bit-weather",
  "version": "2026.10.0",
  "description": "Retro weather education platform with live forecasts, earth-science and space data, aviation and stargazing tools, automated blog/newsletter, Supabase auth, themes, and Playwright-tested flows. Next.js 16, React 19.",
  "private": true,
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --runInBand",
    "test:security-db": "node --test tests/database/*.test.mjs",
    "test:profile": "tsx scripts/test-profile-save.ts",
    "analyze": "ANALYZE=true npm run build",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --reporter=github,html",
    "lighthouse": "lhci autorun",
    "lighthouse:mobile": "lhci autorun --config=lighthouserc.mobile.js",
    "validate:pr": "npm run build && npm run test:e2e && npm run lighthouse && npm run lighthouse:mobile",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "validate:images": "tsx scripts/newsletter/validate-images.ts",
    "validate:education-sources": "tsx scripts/education/validate-sources.ts",
    "education:guide": "tsx scripts/education/index.ts",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sentry/nextjs": "^11.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "astronomy-engine": "^2.1.19",
    "autoprefixer": "^10.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.11.2",
    "gray-matter": "^4.0.3",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "^6.15.0",
    "next": "^16.4.2",
    "ol": "^10.11.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-intersection-observer": "^11.0.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.34.1",
    "satellite.js": "^7.1.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@eslint/eslintrc": "^3.3.7",
    "@jest/globals": "^30.5.2",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^16.4.2",
    "@next/eslint-plugin-next": "^16.4.2",
    "@onkernel/sdk": "^0.129.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.8",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "js-yaml": "5.5.0",
    "knip": "^6.42.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "topojson-client": "^3.1.0",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "world-atlas": "^2.0.2"
  },
  "overrides": {
    "@opentelemetry/api": "1.9.1",
    "basic-ftp": "6.2.3",
    "lodash": "4.18.1",
    "tmp": "^0.2.7",
    "uuid": "^11.1.1",
    "js-yaml@3": "3.15.2",
    "js-yaml@4": "4.3.2",
    "lighthouse": "13.5.0",
    "qs": "^6.16.1",
    "nanoid@3": "3.3.20",
    "next": {
      "postcss": "8.5.31"
    },
    "ws@7": "7.5.13"
  }
}
