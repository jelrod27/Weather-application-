# Weather App Environment Variables
# Copy this file to .env.local and add your actual API keys

# =============================================================================
# IMPORTANT: API Key Security
# =============================================================================
# API keys should NOT have the NEXT_PUBLIC_ prefix unless they are meant
# to be exposed to the browser. Using NEXT_PUBLIC_ exposes keys in the
# client-side JavaScript bundle.
#
# All weather API calls are routed through server-side API routes (app/api/*)
# so these keys remain secure on the server.
# =============================================================================

# Optional: OpenWeatherMap API Key (server-side only)
# NOTE: Primary weather data comes from Open-Meteo (free, no key needed).
# Geocoding was migrated off OpenWeatherMap and now uses Open-Meteo +
# Zippopotam.us + Nominatim, so the app runs without this key.
# This key is only still referenced by legacy/fallback endpoints:
#   pollen, UV (onecall v3), precipitation history, extremes.
# Set it only if you need those specific endpoints. Get a free key from:
# https://openweathermap.org/api
# OPENWEATHER_API_KEY=your_openweather_api_key_here

# Optional: Google Pollen API Key (server-side only)
# Get from Google Cloud Console: https://developers.google.com/maps/documentation/pollen
GOOGLE_POLLEN_API_KEY=your_google_pollen_api_key_here

# Note: Google Air Quality API key no longer needed.
# Air quality data now provided by Open-Meteo (free, no key required).

# News is now sourced entirely from free, keyless RSS/Atom feeds
# (lib/services/rss). No NEWS_API_KEY is required.

# =============================================================================
# Supabase Configuration (these ARE meant to be public)
# =============================================================================
# The Supabase anon key is designed to be public - it only allows access
# that Row Level Security (RLS) policies permit.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# =============================================================================
# Application Configuration
# =============================================================================
# Base URL for the application (used for OAuth redirects, etc.)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# =============================================================================
# Supabase Service Role Key (server-side only, optional)
# =============================================================================
# Required for server-side operations that bypass RLS (e.g., cron jobs, admin tasks)
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# =============================================================================
# Cron Job Protection (server-side only, optional)
# =============================================================================
# Secret used to authenticate cron job requests (e.g., keep-alive endpoint)
# CRON_SECRET=your_cron_secret_here

# =============================================================================
# NASA API (server-side only, optional)
# =============================================================================
# Used for APOD and space weather data
# Get your free API key from: https://api.nasa.gov/
# NASA_API_KEY=your_nasa_api_key_here

# =============================================================================
# Registration admin notifications (server-side only, optional)
# =============================================================================
# Fired when Supabase Database Webhook POSTs to /api/webhooks/new-user on profiles INSERT.
# See planning/supabase-registration-webhook-setup.md for dashboard setup steps.
#
# SUPABASE_WEBHOOK_SECRET=your_random_secret_here
# ADMIN_NOTIFICATION_EMAIL=you@example.com
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=16 Bit Weather <noreply@16bitweather.co>
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
#   Required for post-confirmation welcome emails (welcome_email_sent_at on profiles).
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here

# =============================================================================
# Newsletter Generator (server-side only, optional)
# =============================================================================
# Anthropic model used for newsletter generation, key-phrase extraction, and
# similarity judging. Defaults to claude-sonnet-4-6 if unset.
# NEWSLETTER_MODEL=claude-sonnet-4-6

# =============================================================================
# Rate Limiting Configuration (Optional)
# =============================================================================
# Weather API endpoints are rate-limited to prevent abuse.
# Default limits: 120 requests/hour with a burst of 30 per 5 minutes.
#
# WEATHER_RATE_LIMIT_HOURLY=120        # Max requests per hour per user/IP
# WEATHER_RATE_LIMIT_BURST=30          # Max requests per burst window
# WEATHER_RATE_LIMIT_BURST_WINDOW_MS=300000  # Burst window in milliseconds (5 min)
