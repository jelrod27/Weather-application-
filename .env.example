# Weather App Environment Variables
# Copy this file to .env.local and add your actual API keys

# =============================================================================
# IMPORTANT: API Key Security
# =============================================================================
# API keys should NOT have the NEXT_PUBLIC_ prefix unless they are meant
# to be exposed to the browser. Using NEXT_PUBLIC_ exposes keys in the
# client-side JavaScript bundle.
#
# All weather API calls are routed through server-side API routes (app/api/*)
# so these keys remain secure on the server.
# =============================================================================

# Weather data comes from Open-Meteo (free, no key needed).

# Optional: Google Pollen API Key (server-side only) — recommended for US coverage.
# Without this key, /api/weather/pollen falls back to Open-Meteo CAMS pollen
# (Europe-focused; US locations typically show Unavailable).
# Get from Google Cloud Console: https://developers.google.com/maps/documentation/pollen
GOOGLE_POLLEN_API_KEY=

# Note: Google Air Quality API key no longer needed.
# Air quality data now provided by Open-Meteo (free, no key required).

# News is now sourced entirely from free, keyless RSS/Atom feeds
# (lib/services/rss). No NEWS_API_KEY is required.

# =============================================================================
# Supabase Configuration (these ARE meant to be public)
# =============================================================================
# The Supabase anon key is designed to be public - it only allows access
# that Row Level Security (RLS) policies permit.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# =============================================================================
# Application Configuration
# =============================================================================
# Base URL for the application (used for OAuth redirects, etc.)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# =============================================================================
# Supabase Service Role Key (server-side only, optional)
# =============================================================================
# Required for server-side operations that bypass RLS (e.g., cron jobs, admin tasks)
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# =============================================================================
# Cron Job Protection (server-side only, optional)
# =============================================================================
# Secret used to authenticate cron job requests (e.g., keep-alive endpoint)
# CRON_SECRET=your_cron_secret_here

# =============================================================================
# Web Push (server-side only, optional)
# =============================================================================
# VAPID keypair used to sign web push messages for warning alerts (lib/push/send.ts).
# Push is gated on the PUBLIC and PRIVATE keys only: with either missing, push
# subscription and delivery are skipped and email alerts still go out.
# Generate a keypair with: npx web-push generate-vapid-keys
#
# VAPID_PUBLIC_KEY=your_vapid_public_key
# VAPID_PRIVATE_KEY=your_vapid_private_key
#
# VAPID_SUBJECT is optional and must be a mailto: or https: URL identifying the
# sender. It defaults to mailto:ops@16bitweather.co (lib/push/vapid.ts), so set it
# if you are self-hosting - otherwise your pushes are attributed to this project.
# VAPID_SUBJECT=mailto:you@example.com

# =============================================================================
# NASA API (server-side only, optional)
# =============================================================================
# Used for APOD and space weather data
# Get your free API key from: https://api.nasa.gov/
# NASA_API_KEY=your_nasa_api_key_here

# =============================================================================
# Registration admin notifications (server-side only, optional)
# =============================================================================
# Fired when Supabase Database Webhook POSTs to /api/webhooks/new-user on profiles INSERT.
# See planning/supabase-registration-webhook-setup.md for dashboard setup steps.
#
# SUPABASE_WEBHOOK_SECRET=your_random_secret_here
# ADMIN_NOTIFICATION_EMAIL=you@example.com
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=16 Bit Weather <noreply@16bitweather.co>
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
#   Required for post-confirmation welcome emails (welcome_email_sent_at on profiles).
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here

# =============================================================================
# Newsletter Generator (server-side only, optional)
# =============================================================================
# Anthropic model used for newsletter generation, key-phrase extraction, and
# similarity judging. Defaults to claude-sonnet-4-6 if unset.
# NEWSLETTER_MODEL=claude-sonnet-4-6

# Anthropic model used by the education Guide generator (scripts/education) for
# drafting, fact-checking and metadata. Separate from NEWSLETTER_MODEL so the two
# pipelines can move independently. Defaults to claude-opus-5 if unset.
# EDUCATION_MODEL=claude-opus-5

# Reasoning effort for those calls. Defaults to medium; at the model's own
# default (high) a draft can spend its whole token ceiling thinking.
# Opus 5 / Claude 5: low, medium, high, xhigh, max.
# claude-sonnet-4-6: low, medium, high, max — not xhigh (the API rejects it).
# See scripts/education/model.ts.
# EDUCATION_EFFORT=medium

# =============================================================================
# Rate Limiting Configuration (Optional)
# =============================================================================
# Weather API endpoints are rate-limited per isolated bucket.
# Weather (geocode/forecast/AQ/pollen): 400/hour with a burst of 90 per 5 minutes.
# Account (alerts/prefs/locations) and content (news/stargazer) use separate quotas
# so hub reads cannot 429 city search. Radar tile proxies are not rate-limited.
#
# WEATHER_RATE_LIMIT_HOURLY=400        # Max weather requests per hour per user/IP
# WEATHER_RATE_LIMIT_BURST=90          # Max weather requests per burst window
# WEATHER_RATE_LIMIT_BURST_WINDOW_MS=300000  # Burst window in milliseconds (5 min)

# =============================================================================
# CARTO basemaps (public client key)
# =============================================================================
# Raster tiles at basemaps.cartocdn.com now require ?key= or they render an
# "API key required" watermark. Maps load tiles in the browser, so this MUST
# be NEXT_PUBLIC_ (inlined at build time). Add the same value in Vercel for
# Production, Preview, and Development, then redeploy.
# Request a key: https://carto.com/basemaps/apikey
NEXT_PUBLIC_CARTO_API_KEY=

# Cloudflare Turnstile CAPTCHA (optional)
# When set, the auth forms render a Turnstile challenge and pass the token to
# Supabase. Also set the matching secret key in Supabase Dashboard ->
# Authentication -> Bot and Abuse Protection, or tokens won't be verified.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
